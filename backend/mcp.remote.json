{
  "mcpServers": {
    "blind-docs": {
      "description": "Documentos acessiveis (PDF digital e escaneado com OCR/visao, formularios PDF), audiodescricao de imagem, escrita assistida e leitura/busca limpa da web.",
      "command": "${PYTHON}",
      "args": [
        "-m",
        "blind_mcp.servers.docs"
      ],
      "cwd": "${BACKEND_DIR}",
      "env": {
        "PYTHONUTF8": "1",
        "BLIND_DATA_DIR": "${DATA_DIR}"
      },
      "callTimeout": 120,
      "lazy": true
    },
    "blind-speech": {
      "description": "Fala offline pelo Windows SAPI.",
      "command": "${PYTHON}",
      "args": [
        "-m",
        "blind_mcp.servers.speech"
      ],
      "cwd": "${BACKEND_DIR}",
      "env": {
        "PYTHONUTF8": "1",
        "BLIND_DATA_DIR": "${DATA_DIR}"
      },
      "lazy": true
    },
    "blind-schedule": {
      "description": "Agendamento do Blind: tarefas e lembretes falados (blindschedule_create, blindschedule_list, blindschedule_snooze, blindschedule_delete).",
      "command": "${PYTHON}",
      "args": [
        "-m",
        "blind_mcp.servers.schedule"
      ],
      "cwd": "${BACKEND_DIR}",
      "env": {
        "PYTHONUTF8": "1",
        "BLIND_DATA_DIR": "${DATA_DIR}"
      }
    }
  }
}