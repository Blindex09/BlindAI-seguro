# ========================================================
# BLIND AI - CONFIGURAÇÃO DO ASSISTENTE DE ACESSIBILIDADE
# ========================================================

# --- Escolha da IA Principal ---
# Para IA local (Grátis, instalada no seu PC):
# Defina BLIND_LLM_PROVIDER como "opencode", "ollama", "lmstudio" ou "custom"
BLIND_LLM_PROVIDER=opencode
BLIND_LLM_MODEL=opencode-zen
LOCAL_ENDPOINT_URL=http://127.0.0.1:11434/v1

# Para IA Paga em Nuvem (preencha sua chave conforme preferência):
# BLIND_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# BLIND_LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# BLIND_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...

# --- Síntese de Voz (TTS) ---
# "piper" (offline local) ou "openai" / "gemini"
BLIND_TTS_PROVIDER=piper
BLIND_TTS_VOICE=pt_BR-faber-medium

# --- Transcrição de Áudio (STT) ---
# "whisper_cpp" (offline local) ou "openai"
BLIND_STT_PROVIDER=whisper_cpp

# --- Palavra de Ativação (Wake-Word) ---
# Comando fixo exclusivo: "Blind" (outros comandos como "ei hermes" foram desativados)
BLIND_WAKE_WORD_ENABLED=true

# --- Canais Remotos (WhatsApp / Telegram) ---
TELEGRAM_BOT_TOKEN=
WHATSAPP_ENABLED=false
