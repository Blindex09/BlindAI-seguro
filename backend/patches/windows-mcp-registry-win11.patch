+_NT_CURRENTVERSION = "software\\microsoft\\windows nt\\currentversion"
+
+
+def _windows_11_note(path: str, name: str, value: str) -> tuple[str, str]:
+    """Windows 11 still stores "Windows 10 ..." in ProductName for compatibility.
+
+    Reading that value as-is tells the user the wrong operating system. When the
+    key is HKLM\\...\\Windows NT\\CurrentVersion, the value is ProductName and the
+    build number is 22000 or higher, return the corrected name and a short note.
+    Returns (value, note); note is empty when nothing was corrected.
+    """
+    try:
+        normalized = path.lower().replace("hklm:", "").replace("hkey_local_machine", "").replace("/", "\\").strip("\\ ")
+        if normalized != _NT_CURRENTVERSION or name.lower() != "productname" or not value.startswith("Windows 10"):
+            return value, ""
+        import winreg
+
+        with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion") as key:
+            build = int(winreg.QueryValueEx(key, "CurrentBuildNumber")[0])
+    except Exception:  # noqa: BLE001 - never break the read because of the correction
+        return value, ""
+    if build < 22000:
+        return value, ""
+    corrected = "Windows 11" + value[len("Windows 10"):]
+    note = (
+        f' [corrected: the registry still says "{value}" for compatibility; '
+        f"build {build} is Windows 11, so the real name is \"{corrected}\"]"
+    )
+    return corrected, note
+
+
